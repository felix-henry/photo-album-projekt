@startuml klassendiagramm
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

package application {
  class AddPhotoUseCase {
    + execute(albumId: AlbumId, sourcePath: String): Result<PhotoView>
  }
  class CreateAlbumUseCase {
    + execute(name: String): Result<AlbumSummary>
  }
  interface Result<T> <<sealed>> {
    + {static} success(value: T): Result<T>
    + {static} failure(message: String): Result<T>
  }
  class ErrorMessages
  class AlbumSummary <<record>>
  class PhotoView <<record>>
  class SuggestTitleUseCase <<Entwurf>>
}

package "application.port" {
  interface AlbumRepository {
    + findAll(): List<Album>
    + findById(id: AlbumId): Optional<Album>
    + save(album: Album)
    + delete(id: AlbumId)
  }
  interface ImageInspector {
    + inspect(source: Path): ImageInfo
  }
  class ImageInfo <<record>> {
    - type: ImageType
    - sizeBytes: long
    - hash: ContentHash
  }
  interface PhotoStorage {
    + store(photo: Photo, source: Path)
    + delete(photo: Photo)
  }
  class StorageException <<exception>>
  class ImageNotReadableException <<exception>>
  interface TitleSuggester <<Entwurf>> {
    + suggestTitle(imageContent: byte[]): Optional<String>
  }
}

package domain {
  class Album {
    + {static} MAX_PHOTOS: int = 10000
    - id: AlbumId
    - name: AlbumName
    + addPhoto(photo: Photo)
    + removePhoto(id: PhotoId): Photo
    + rename(name: AlbumName)
    + describePhoto(id: PhotoId, title: String, description: String)
  }
  note right of Album : addPhoto prüft erst Duplikat, dann Anzahl.
  class Photo <<record>> {
    + {static} MAX_FILE_SIZE_BYTES: long
    + {static} MAX_TITLE_LENGTH: int
    + {static} MAX_DESCRIPTION_LENGTH: int
    - id: PhotoId
    - hash: ContentHash
    - fileName: String
    - type: ImageType
    - sizeBytes: long
    - title: String
    - description: String
    + Photo(id, hash, fileName, type, sizeBytes)
    + describe(title: String, description: String): Photo
  }
  class AlbumName <<record>> {
    + {static} MAX_LENGTH: int
    - value: String
    + {static} requireUnique(candidate: AlbumName, others: Collection<AlbumName>)
  }
  class ContentHash <<record>>
  class AlbumId <<record>> {
    + {static} newId(): AlbumId
  }
  class PhotoId <<record>> {
    + {static} newId(): PhotoId
  }
  enum ImageType {
    JPEG
    PNG
    OTHER
    + {static} fromHeader(header: byte[]): ImageType
  }
  abstract class DomainException <<exception>>
  class InvalidAlbumNameException <<exception>>
  class TextTooLongException <<exception>>
  class DuplicatePhotoException <<exception>>
  class AlbumFullException <<exception>>
  class UnsupportedImageException <<exception>>
}

package infrastructure {
  class FileAlbumRepository
  class FilePhotoStorage
  class FileImageInspector
  class HttpTitleSuggester <<Entwurf>>
}

Album "1" *-- "0..10000" Photo : photos
DomainException <|-- InvalidAlbumNameException
DomainException <|-- DuplicatePhotoException
DomainException <|-- AlbumFullException
DomainException <|-- UnsupportedImageException
DomainException <|-- TextTooLongException
AlbumName ..> InvalidAlbumNameException : «throw»
Album ..> DuplicatePhotoException : «throw»
Album ..> AlbumFullException : «throw»
Photo ..> UnsupportedImageException : «throw»
Photo ..> TextTooLongException : «throw»

AddPhotoUseCase --> "1" AlbumRepository
AddPhotoUseCase --> "1" ImageInspector
AddPhotoUseCase --> "1" PhotoStorage
AddPhotoUseCase ..> Photo : «create»
AddPhotoUseCase ..> ErrorMessages : «use»
ErrorMessages ..> Album : «use»
ErrorMessages ..> AlbumName : «use»
ErrorMessages ..> Photo : «use»
CreateAlbumUseCase --> "1" AlbumRepository
CreateAlbumUseCase ..> Album : «create»
SuggestTitleUseCase --> "1" TitleSuggester

ImageInspector ..> ImageInfo
ImageInspector ..> ImageNotReadableException : «throw»
AlbumRepository ..> StorageException : «throw»
PhotoStorage ..> StorageException : «throw»

AlbumRepository <|.. FileAlbumRepository
PhotoStorage <|.. FilePhotoStorage
ImageInspector <|.. FileImageInspector
TitleSuggester <|.. HttpTitleSuggester
@enduml
